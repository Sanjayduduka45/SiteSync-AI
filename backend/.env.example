# SiteSync AI — Backend Environment Variables
#
# Copy to .env for local development.
# NEVER commit .env to Git.
#
# Backend reads these at startup via pydantic-settings.


# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0

# ── Server ───────────────────────────────────────────────────
PORT=8000

# Allowed CORS origins (comma-separated). Must include the frontend URL.
CORS_ORIGINS=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Project URL from Supabase Dashboard > Settings > API
SUPABASE_URL=your_supabase_project_url_here

# Anonymous/public key — limited permissions (safe for reference, not privileged)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — SERVER-SIDE ONLY. Never expose to frontend or clients.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret from Supabase Dashboard > Settings > API (used for token verification)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Direct PostgreSQL connection string (Supabase connection pooler recommended)
DATABASE_URL=your_supabase_postgres_connection_string_here
