# SiteSync AI — Frontend Environment Variables
#
# Copy to .env.local for local development.
# NEVER commit .env.local to Git.
#
# Vite exposes variables prefixed with VITE_ to the client bundle.
# Do NOT put secrets or service-role keys here.

# Backend API base path (used by the frontend API service layer)
# In development, the Vite dev server proxies /api to localhost:8000
# so this can be omitted for local dev. Set it for staging/production.
VITE_API_URL=/api

# Supabase public URL (safe for client — no secret)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase anonymous key (safe for client — limited permissions)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
