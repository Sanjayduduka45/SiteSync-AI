# SiteSync AI — Environment Variables Template
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# .env is listed in .gitignore.
#
# All values here are placeholders. Replace with your actual credentials.

# ============================================================
# SUPABASE
# ============================================================

# Your Supabase project URL (from Supabase Dashboard > Settings > API)
SUPABASE_URL=your_supabase_project_url_here

# Supabase anonymous/public key (safe for client-side use)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (SERVER-SIDE ONLY — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase database connection string (for direct PostgreSQL access from backend)
DATABASE_URL=your_supabase_postgres_connection_string_here

# ============================================================
# AI / GEMINI
# ============================================================

# Google Gemini API key (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# LangChain tracing (optional, for development)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here_if_using_tracing

# ============================================================
# BACKEND (FastAPI)
# ============================================================

# Environment: development | staging | production
APP_ENV=development

# Secret key for signing tokens (generate a strong random value)
SECRET_KEY=your_strong_random_secret_key_here

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Backend port
PORT=8000

# ============================================================
# FRONTEND (React + Vite)
# ============================================================

# Vite exposes env vars to the client when prefixed with VITE_
# These are embedded into the client-side bundle — do NOT put secrets here.

# Backend API base URL
VITE_API_URL=http://localhost:8000/api/v1

# Supabase public URL (safe for client)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Supabase anonymous key (safe for client)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
